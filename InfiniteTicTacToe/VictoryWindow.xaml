<Window x:Class="InfiniteTicTacToe.VictoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кінець гри" Height="300" Width="450" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#2f3640" CornerRadius="15" BorderBrush="#111" BorderThickness="3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.8" Color="Black"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Border x:Name="IconBorder" Background="#fbc531" Width="60" Height="60" CornerRadius="30" Margin="0,0,0,15">
                <TextBlock x:Name="IconText" Text="🏆" Foreground="White" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="WinnerText" Text="Гравець виграв!" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="ГРАТИ ЗНОВУ" Width="180" Height="45" Background="#44bd32" Foreground="White" FontWeight="Bold" FontSize="18" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>