<Window x:Class="InfiniteTicTacToe.VictoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кінець гри" Height="250" Width="400" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#2f3640" CornerRadius="15" BorderBrush="#fbc531" BorderThickness="3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🏆 ПЕРЕМОГА! 🏆" Foreground="#fbc531" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="WinnerText" Text="Гравець виграв!" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <Button Content="ГРАТИ ЗНОВУ" Width="150" Height="40" Background="#44bd32" Foreground="White" FontWeight="Bold" FontSize="16" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>